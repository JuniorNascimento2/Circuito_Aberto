PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=circuito_aberto
# Gere sua própria chave (não reutilize esta nem nenhuma chave de exemplo):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_longa_gerada_por_voce
CLIENT_URL=http://localhost:4000

# Número de proxies reversos na frente da aplicação (Nginx/Apache/gateway da
# instituição, balanceador de carga). Deixe 1 se houver só um proxy na frente
# (caso comum). Se não tiver certeza, pergunte ao time de infraestrutura.
TRUST_PROXY=1

# E-mail (opcional em desenvolvimento, obrigatório em produção)
# Use uma "Senha de App" do Gmail, não a senha normal da conta
# Para criar: myaccount.google.com > Segurança > Senhas de app
MAIL_USER=seuemail@gmail.com
MAIL_PASS=sua_senha_de_app_gmail

# Limites de requisição por IP (opcionais — os padrões abaixo já são os usados)
# Aumente se muita gente compartilha o mesmo IP (laboratório, rede da escola).
LIMITE_GERAL=100
LIMITE_AUTENTICACAO=10
LIMITE_ACOES=60
